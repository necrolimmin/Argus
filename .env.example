# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32

# Server IP (or DNS name) as seen from operators' computers. Browsers fetch
# video from this address on port 8555 (TCP and UDP must be open).
ARGUS_PUBLIC_HOST=192.168.1.10
ARGUS_HTTP_PORT=80

POSTGRES_PASSWORD=change-me

ARGUS_SECRET_KEY=change-me
# Encrypts camera passwords. Generate once and never change it:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ARGUS_ENCRYPTION_KEY=
ARGUS_SERVICE_TOKEN=change-me

# First administrator, created on the first start only.
ARGUS_ADMIN_USERNAME=admin
ARGUS_ADMIN_PASSWORD=change-me

ARGUS_TIMEZONE=Asia/Tashkent
ARGUS_RETENTION_DAYS=60
ARGUS_DEDUP_SECONDS=60
ARGUS_MATCH_THRESHOLD=0.45
